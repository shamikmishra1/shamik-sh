<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="software.amazon.awssdk" level="WARN" />
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
